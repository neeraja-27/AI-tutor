{
  "name": "ai-learning-companion",
  "version": "1.0.0",
  "description": "AI-Powered Learning & Growth Workspace (MERN + Python RAG)",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev:rag": "cd rag-service && uvicorn main:app --reload --port 8000",
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
    "install:rag": "cd rag-service && pip install -r requirements.txt",
    "install:all": "npm run install:server && npm run install:client && npm run install:rag"
  },
  "keywords": [
    "ai",
    "rag",
    "learning-companion",
    "mern",
    "chromadb",
    "groq"
  ],
  "author": "",
  "license": "MIT"
}
